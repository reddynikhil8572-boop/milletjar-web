# Copy to .env.local (or .env) and fill in the values.
# Never commit the real file - only this example is tracked.

# Public site config
# Digits only, e.g. 919876543210. The sample placeholder is rejected in production.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CONTACT_EMAIL=hello@milletjar.in
# Real public origin, e.g. https://www.milletjar.in. Required in production.
APP_URL=http://localhost:3000
# Google Search Console HTML-tag verification token (no quotes, from GSC)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Session secrets - generate with: openssl rand -base64 48
AUTH_SECRET=
ADMIN_AUTH_SECRET=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase: data store + admin sign-in (required for /admin/login)
# Run supabase/schema.sql in the SQL Editor, then:
#   npm run create:admin -- admin@milletjar.in "a-strong-password"
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Online payment gateways are intentionally not configured.
# Orders and inquiries are handled over WhatsApp only.

# Set to false only when the app is exposed directly, without a trusted proxy.
TRUST_PROXY=true

# Local store fallback when Supabase is not configured
DATA_DIR=.data
